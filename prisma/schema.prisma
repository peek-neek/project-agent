// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportMode {
  single
  compare
  bulk
}

enum JobStatus {
  queued
  running
  completed
  failed
}

model Report {
  id           String     @id @default(uuid())
  /// Clerk user ID of the agent who created the report.
  userId       String
  mode         ReportMode @default(single)
  /// Address exactly as the agent typed or selected it.
  inputAddress String
  /// Google place ID when the address was picked from autocomplete.
  placeId      String?
  /// Agent's own label for the report (sidebar); null shows the address.
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  property PropertyIdentity?
  jobs     ReportJob[]
  sections ReportSection[]

  comparisonsAsA Comparison[] @relation("ComparisonA")
  comparisonsAsB Comparison[] @relation("ComparisonB")

  @@index([userId, createdAt(sort: Desc)])
}

/// Two reports compared side by side. Each property is an ordinary report
/// (made by the usual pipeline, or reused); deleting either one deletes the
/// comparison, never the other report.
model Comparison {
  id        String   @id @default(uuid())
  /// Clerk user ID of the agent who created the comparison.
  userId    String
  reportAId String
  reportA   Report   @relation("ComparisonA", fields: [reportAId], references: [id], onDelete: Cascade)
  reportBId String
  reportB   Report   @relation("ComparisonB", fields: [reportBId], references: [id], onDelete: Cascade)
  /// Agent's own label (sidebar); null shows "A vs B".
  name      String?
  /// The comparison chat thread (Trigger.dev chat id, transcript, cursors).
  chat      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([reportAId])
  @@index([reportBId])
}

/// Property basics: identification (address, unit, legal description, PIN, roll).
model PropertyIdentity {
  reportId String @id
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  formattedAddress String?
  streetNumber     String?
  streetName       String?
  unitNumber       String?
  city             String?
  province         String?
  postalCode       String?
  country          String?
  latitude         Float?
  longitude        Float?

  legalDescription String?
  /// Land Registry Property Identifier Number (9 digits, e.g. 21234-0567).
  pin              String?
  /// MPAC assessment roll number.
  rollNumber       String?

  /// Per-field provenance: { [field]: { source, asOf } }.
  sources Json @default("{}")

  updatedAt DateTime @updatedAt
}

/// One background extraction job (Trigger.dev run) for a report.
model ReportJob {
  id           String    @id @default(uuid())
  reportId     String
  report       Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Which extractor this is, e.g. "property-identity".
  kind         String
  status       JobStatus @default(queued)
  triggerRunId String?
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([reportId, kind])
}

/// Generated or agent-entered data for one report section, validated in code
/// with the zod schemas in src/lib/report-sections.ts.
model ReportSection {
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// e.g. "listing", "amenities", "commute", "insights", "marketing".
  key       String
  data      Json
  updatedAt DateTime @updatedAt

  @@id([reportId, key])
}

/// Ontario public schools, imported from the Ministry of Education's
/// "School information and student demographics" dataset
/// (npm run data:schools). EQAO columns are % of students meeting the
/// provincial standard; null when not reported.
model School {
  /// Ministry school number.
  id           String  @id
  name         String
  boardName    String
  boardWebsite String?
  /// "Public" or "Catholic".
  type         String
  /// "Elementary" or "Secondary".
  level        String
  /// "English" or "French".
  language     String
  gradeRange   String?
  street       String?
  city         String?
  postalCode   String?
  phone        String?
  website      String?
  enrolment    Int?
  latitude     Float
  longitude    Float

  g3Reading Int?
  g3Writing Int?
  g3Math    Int?
  g6Reading Int?
  g6Writing Int?
  g6Math    Int?
  g9Math    Int?
  /// Grade 10 literacy test (OSSLT), first-time eligible students passing.
  osslt     Int?

  /// School year of the source data, e.g. "2024-25".
  dataYear  String
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
}

/// Public and Catholic K–12 schools outside Ontario, from Statistics Canada's
/// Open Database of Educational Facilities (Open Government Licence –
/// Canada). Ontario uses School (ministry data with EQAO). Replaced whole by
/// the "import-canada-schools" task.
model CanadaSchool {
  /// ODEF record index.
  id           String  @id
  name         String
  boardName    String?
  /// "Public" or "Catholic".
  type         String
  /// "English" or "French".
  language     String
  /// Teaches the elementary grades (a K–12 school is both).
  elementary   Boolean
  /// Teaches the secondary grades (junior high included).
  secondary    Boolean
  street       String?
  city         String?
  /// Two-letter code, e.g. "BC".
  province     String
  postalCode   String?
  latitude     Float
  longitude    Float
  /// True when placed from its address (Google Geocoding) rather than the
  /// source's own coordinates.
  geocoded     Boolean  @default(false)
  /// Rough position (a rural box address placed at its town).
  approximate  Boolean  @default(false)
  /// Release of the source data, e.g. "ODEF 2.1 (2022)".
  dataYear     String
  updatedAt    DateTime @updatedAt

  @@index([latitude, longitude])
}

/// Provincial infrastructure projects in planning or under construction,
/// from Ontario's "Ontario Builds" open data. Refreshed weekly by the
/// refresh-ontario-builds Trigger.dev schedule (or npm run data:projects).
model InfrastructureProject {
  /// Stable hash of name + location (the source has no IDs).
  id               String   @id
  /// Which dataset it came from ("Ontario Builds", "Alberta Major Projects",
  /// "BC Major Projects Inventory"); each import replaces only its own rows.
  source           String   @default("Ontario Builds")
  /// e.g. "Transit", "Health care", "Education".
  category         String
  name             String
  /// "Planning" or "Under construction".
  status           String
  /// Display label, e.g. "Mar 2027", "2028–2029"; null when to be determined.
  targetCompletion String?
  community        String?
  address          String?
  transitLine      String?
  budget           Float?
  website          String?
  description      String?
  latitude         Float
  longitude        Float
  updatedAt        DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([source])
}

/// Federally funded infrastructure projects (Infrastructure Canada / Housing,
/// Infrastructure and Communities Canada, Open Government Licence – Canada),
/// planned or underway. The source gives each project's municipality, not a
/// location, so reports list them by municipality. Refreshed weekly by the
/// refresh-federal-projects task.
model FederalProject {
  /// Infrastructure Canada project number.
  id                  String   @id
  title               String
  /// Report category, e.g. "Transit", "Health care" (PROJECT_CATEGORIES).
  category            String
  program             String?
  /// "Planning" or "Under construction".
  status              String
  /// Display label, e.g. "2028"; null when not forecast.
  targetCompletion    String?
  /// The source's municipality text, e.g. "Saskatoon" or "Moncton, Dieppe".
  municipalities      String
  /// Normalized municipality names, for matching (see federal-projects.ts).
  municipalityKeys    String[]
  /// Two-letter province code, e.g. "SK".
  province            String
  federalContribution Float?
  totalCost           Float?
  updatedAt           DateTime @updatedAt

  @@index([province])
}

/// City of Toronto community planning applications (rezonings, site plans,
/// subdivisions, condos), one row per application. Refreshed daily by the
/// refresh-toronto-development Trigger.dev schedule (or npm run data:development).
model DevelopmentApplication {
  /// City application number, e.g. "15 177458 WET 03 OZ".
  id          String    @id
  /// OZ, SA, SB, CD or PL.
  type        String
  status      String
  submittedAt DateTime?
  address     String
  description String?
  url         String?
  /// Parsed from the description when stated.
  units       Int?
  storeys     Int?
  latitude    Float
  longitude   Float
  updatedAt   DateTime  @updatedAt

  @@index([latitude, longitude])
}

enum Plan {
  starter
  pro
}

/// One row per Clerk user who has started checkout. Mirrors the user's Stripe
/// customer and current subscription; kept in sync by the Stripe webhook
/// (src/app/api/stripe/webhook/route.ts). Stripe is the source of truth.
model BillingAccount {
  /// Clerk user ID.
  userId               String    @id
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  plan                 Plan?
  stripePriceId        String?
  /// Stripe subscription status: active, trialing, past_due, canceled, ...
  status               String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Extra reports bought at C$15 each and not yet used. Used only once the
  /// month's plan allowance is gone; they don't expire.
  extraReportCredits   Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  creditPurchases ExtraReportPurchase[]
}

/// One paid Checkout Session for extra reports. The session ID as primary
/// key means a webhook retry can never add the same credits twice.
model ExtraReportPurchase {
  checkoutSessionId String         @id
  userId            String
  account           BillingAccount @relation(fields: [userId], references: [userId], onDelete: Cascade)
  quantity          Int
  /// Total charged, in cents (CAD), before tax.
  amountSubtotal    Int
  /// Credits taken back because the payment was refunded (in part or full).
  /// Refund events carry the running total, so this makes them idempotent.
  creditsRevoked    Int            @default(0)
  createdAt         DateTime       @default(now())

  @@index([userId])
}

/// Stripe webhook events already processed, so retries are handled once.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// One AI chat message an agent sent (one per answered turn), for the plan's
/// monthly chat allowance. Keyed by the assistant message ID, so a retried
/// hook can't count the same turn twice.
model ChatMessageUsage {
  messageId String   @id
  userId    String
  reportId  String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// One report created by an agent, for the plan's monthly report allowance.
/// Separate from Report so deleting a report doesn't give the allowance back.
model ReportUsage {
  reportId  String   @id
  userId    String
  /// Paid with an extra-report credit (beyond the monthly allowance).
  usedCredit Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
